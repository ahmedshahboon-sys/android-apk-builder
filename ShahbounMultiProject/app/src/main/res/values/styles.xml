<resources>
    <style name="Theme.ShahbounMulti" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF7A00</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#3A210E</item>
        <item name="colorOnPrimaryContainer">#FFD9B8</item>
        <item name="colorSecondary">#FF9B42</item>
        <item name="colorSurface">#181520</item>
        <item name="colorOnSurface">#F5F2FA</item>
        <item name="colorSurfaceContainer">#1F1B2A</item>
        <item name="android:colorAccent">#FF7A00</item>
        <item name="android:windowBackground">#0D0B12</item>
        <item name="android:navigationBarColor">#0D0B12</item>
        <item name="android:statusBarColor">#0D0B12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ShahbounMulti.AlertDialog</item>
    </style>

    <style name="ThemeOverlay.ShahbounMulti.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">#FF7A00</item>
        <item name="colorSecondary">#FF9B42</item>
        <item name="colorSurface">#181520</item>
        <item name="colorOnSurface">#F5F2FA</item>
        <item name="android:colorAccent">#FF7A00</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ShahbounMulti.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ShahbounMulti.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ShahbounMulti.DialogButton</item>
    </style>

    <style name="Widget.ShahbounMulti.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">#FF8A1F</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
