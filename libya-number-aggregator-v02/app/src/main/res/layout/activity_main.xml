<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="كاشف الأرقام الموحّد"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بحث موحّد بالرقم أو الاسم ومقارنة النتائج بين عدة مصادر"
            android:layout_marginTop="6dp" />
        <EditText
            android:id="@+id/query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رقم الهاتف أو الاسم"
            android:singleLine="true"
            android:layout_marginTop="20dp" />
        <RadioGroup
            android:id="@+id/searchType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">
            <RadioButton
                android:id="@+id/byPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بالرقم"
                android:checked="true" />
            <RadioButton
                android:id="@+id/byName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بالاسم"
                android:layout_marginStart="20dp" />
        </RadioGroup>
        <Button
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="بحث في كل المصادر"
            android:layout_marginTop="12dp" />
        <Button
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات المصادر 1–5" />
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_margin="12dp" />
        <TextView
            android:id="@+id/sourceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="حالة المصادر ستظهر هنا"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
